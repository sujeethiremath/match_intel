# Match Intel — Environment Configuration Example
# Copy this file to .env and replace placeholder values with your real credentials.

# ─── EMAIL & SMTP CONFIGURATION ─────────────────────────────────────────────
# 16-character Gmail App Password (generated via Google Account -> Security -> 2-Step Verification)
GMAIL_APP_PASSWORD=your_gmail_app_password_here
EMAIL_RECIPIENT=recipient@example.com
EMAIL_SENDER=sender@example.com

# ─── DATABASE CONFIGURATION ────────────────────────────────────────────────
# PostgreSQL database user password
DB_PASSWORD=your_database_password_here

# ─── DATA API KEYS ─────────────────────────────────────────────────────────
# CricAPI authentication key (cricapi.com)
CRICAPI_KEY=your_cricapi_key_here

# Exa Search API key (exa.ai) — used as fallback when SearXNG yields no snippets
EXA_API_KEY=your_exa_api_key_here

# ─── SEARCH & INFRASTRUCTURE ───────────────────────────────────────────────
# Self-hosted SearXNG search engine URL
SEARXNG_URL=http://localhost:8080

# Mac Mini / AI Inference Host Configuration
MAC_MINI_HOST=localhost
MAC_MINI_PORT=8001
MAC_MINI_MAC_ADDRESS=00:11:22:33:44:55

# Pipeline Logging Directory (optional)
LOG_DIR=logs
